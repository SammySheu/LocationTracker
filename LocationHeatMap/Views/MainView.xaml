<?xml version="1.0" encoding="utf-8" ?>
<!--
    MainView — the app's only page.

    Layout matches the reference screenshot: a navigation bar titled "MainView" above a
    full-bleed map. The translucent control strip at the bottom is an addition, so that the
    heat map can be started, stopped and reset without rebuilding the app.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:viewmodels="clr-namespace:LocationHeatMap.ViewModels"
             x:Class="LocationHeatMap.Views.MainView"
             x:DataType="viewmodels:MainViewModel"
             Title="MainView">

    <Grid>
        <!--
            IsShowingUser draws the platform's own "you are here" indicator — the blue dot on
            Apple Maps, and the blue dot plus the re-centre button on Google Maps.
            The heat map overlay itself is added to MapElements from code-behind.
        -->
        <maps:Map x:Name="HeatMap"
                  IsShowingUser="True"
                  IsScrollEnabled="True"
                  IsZoomEnabled="True"
                  MapType="Street" />

        <!-- Control strip, floating over the bottom of the map. -->
        <Border VerticalOptions="End"
                Margin="16,0,16,28"
                Padding="14,10"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#F2FFFFFF, Dark=#F2202020}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.25" Radius="8" Offset="0,2" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12"
                  VerticalOptions="Center">

                <Button Grid.Column="0"
                        Text="{Binding TrackingButtonText}"
                        Command="{Binding ToggleTrackingCommand}"
                        WidthRequest="88"
                        HeightRequest="40"
                        Padding="0"
                        CornerRadius="10"
                        FontAttributes="Bold" />

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="{Binding RecordedPointLabel}"
                           FontAttributes="Bold"
                           FontSize="15" />
                    <Label Text="{Binding StatusMessage}"
                           FontSize="12"
                           Opacity="0.65"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        Text="Clear"
                        Command="{Binding ClearCommand}"
                        WidthRequest="72"
                        HeightRequest="40"
                        Padding="0"
                        CornerRadius="10"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#B00020, Dark=#FF6B6B}" />
            </Grid>
        </Border>
    </Grid>

</ContentPage>
